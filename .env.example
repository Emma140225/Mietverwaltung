# ==============================================================================
# Private Hausverwaltung - Umgebungsvariablen (Vorlage)
# Kopiere diese Datei nach `.env` und passe die Werte für dein NAS an.
# ==============================================================================

# --- PostgreSQL Datenbank ---
POSTGRES_DB=mietverwaltung
POSTGRES_USER=hausverwaltung
POSTGRES_PASSWORD=BITTE_SICHERES_PASSWORT_SETZEN
POSTGRES_PORT=5432

# Asynchrone SQLAlchemy/Alembic Verbindungs-URL (Container-intern: Host "db")
DATABASE_URL=postgresql+asyncpg://hausverwaltung:BITTE_SICHERES_PASSWORT_SETZEN@db:5432/mietverwaltung

# --- FastAPI Anwendung ---
APP_PORT=8000
APP_ENV=production
LOG_LEVEL=info
TZ=Europe/Berlin

# --- PDF-Dokumentenablage (NAS-Volume) ---
# Pfad im Container (nicht ändern, muss zum Mount in docker-compose.yml passen)
DOKUMENTE_ROOT=/data/dokumente
# Pfad auf dem Host/NAS (z. B. /volume1/docker/mietverwaltung/dokumente)
DOKUMENTE_HOST_PATH=./data/dokumente
# Maximale Upload-Größe pro PDF-Datei in MB
MAX_UPLOAD_SIZE_MB=25
